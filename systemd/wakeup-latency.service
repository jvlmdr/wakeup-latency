[Unit]
Description=Measure per-CPU userspace timer wake-up latency
Documentation=file:///usr/local/share/doc/wakeup-latency/README.md

[Service]
Type=simple
DynamicUser=yes
RuntimeDirectory=wakeup-latency
RuntimeDirectoryMode=0755
ExecStartPre=/bin/rm -f /run/wakeup-latency/metrics.prom
ExecStart=/usr/local/bin/wakeup-latency --continuous --interval-us 10000 --textfile /run/wakeup-latency/metrics.prom
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
MemoryMax=64M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
CapabilityBoundingSet=
UMask=0022

[Install]
WantedBy=multi-user.target
